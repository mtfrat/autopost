# Required server-only configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PUNA_COMPANY_ID=00000000-0000-0000-0000-000000000000
AUTOPOST_WORKER_TOKEN=replace-with-at-least-32-random-characters

# Phase 0 safety gates. Keep both disabled in production.
AUTOPOST_SCHEDULER_ENABLED=false
AUTOPOST_MUTATIONS_ENABLED=false
AUTOPOST_ALLOWED_IMAGE_HOSTS=.supabase.co

# Existing generation providers (server-only)
GEMINI_API_KEY=your-gemini-api-key
REPLICATE_API_TOKEN=your-replicate-api-token
